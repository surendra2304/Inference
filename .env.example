# ==============================================================================
#                 INFERENCE — PRODUCTION CONFIGURATION TEMPLATE
# ==============================================================================
# Identity: Centralized LLM Gateway & Provider Fallback Router for FRIDAY Universe
# Network: friday_mesh | Domain: https://friday-universe.duckdns.org/inference

# ── Primary Provider API Key Pools (Comma-separated or singular) ───────────────
# Google Gemini
GEMINI_API_KEYS=""
GEMINI_API_KEY=""

# Groq Cloud (Ultra-low latency LPU)
GROQ_API_KEYS=""
GROQ_API_KEY=""

# Cerebras Inference (World-record token generation speed)
CEREBRAS_API_KEYS=""
CEREBRAS_API_KEY=""

# OpenRouter (Aggregated provider fallback)
OPENROUTER_API_KEYS=""
OPENROUTER_API_KEY=""

# NVIDIA NIM / Nemotron
NVIDIA_API_KEYS=""
NVIDIA_API_KEY=""

# Mistral AI
MISTRAL_API_KEYS=""
MISTRAL_API_KEY=""

# Cohere
COHERE_API_KEYS=""
COHERE_API_KEY=""

# HuggingFace Inference API
HUGGINGFACE_API_KEYS=""
HUGGINGFACE_API_KEY=""

# ── Third-Party & Fallback Pools ───────────────────────────────────────────────
THIRD_PARTY_GEMINI_KEYS=""
THIRD_PARTY_GEMINI_KEY=""
GEMINI_FALLBACK_KEYS=""
GEMINI_FALLBACK_KEY=""

THIRD_PARTY_GROQ_KEYS=""
THIRD_PARTY_GROQ_KEY=""
GROQ_FALLBACK_KEYS=""
GROQ_FALLBACK_KEY=""

THIRD_PARTY_OPENROUTER_KEYS=""
THIRD_PARTY_OPENROUTER_KEY=""
OPENROUTER_FALLBACK_KEYS=""
OPENROUTER_FALLBACK_KEY=""

THIRD_PARTY_NVIDIA_KEYS=""
THIRD_PARTY_NVIDIA_KEY=""

# ── Security & Authentication ──────────────────────────────────────────────────
# Required for all model execution and state routes (set a strong random secret)
INFERENCE_API_KEY=""
FRIDAY_API_KEY=""
FRIDAY_UNIVERSE_API_KEY=""
X_FRIDAY_API_KEY=""

# ── Server & Gateway Runtime Configuration ────────────────────────────────────
APP_NAME="Inference"
APP_ENV="production"
HOST="0.0.0.0"
PORT=8000
INFERENCE_URL="https://friday-universe.duckdns.org/inference"
DATABASE_URL="sqlite:///data/universe.db"

# ── Concurrency & Memory Guard ────────────────────────────────────────────────
WEB_CONCURRENCY=1
MEMORY_TRIM_ENABLED=true
MEMORY_TRIM_THRESHOLD_MB=400.0
MEMORY_TRIM_COOLDOWN_SECONDS=60.0

# ── Self-Hosted / Local LLM Tier (Optional) ───────────────────────────────────
LOCAL_ENABLED=false
LOCAL_BASE_URL="http://127.0.0.1:11434/v1"
LOCAL_MODEL="local-model"
LOCAL_PREFERRED=false
