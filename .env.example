# 7 Active Cloud Provider API Keys (Permanently Free Tiers)
# Comma-separated keys supported for automatic round-robin pooling & failover (e.g. key1,key2)
GEMINI_API_KEYS=""
GROQ_API_KEYS=""
MISTRAL_API_KEYS=""
OPENROUTER_API_KEYS=""
COHERE_API_KEYS=""
HUGGINGFACE_API_KEYS="your_huggingface_api_key_here"
NVIDIA_API_KEYS=""

# Backward-compatible singular formats are also supported:
GEMINI_API_KEY=""
GROQ_API_KEY=""
MISTRAL_API_KEY=""
OPENROUTER_API_KEY=""
COHERE_API_KEY=""
HUGGINGFACE_API_KEY=""
NVIDIA_API_KEY=""

# Integration Keys
FRIDAY_UNIVERSE_API_KEY=""
X_FRIDAY_API_KEY=""
FRIDAY_API_KEY=""

# Database Configuration
DATABASE_URL="sqlite+aiosqlite:///data/universe.db"

# Server Configuration
APP_NAME="Inference"
APP_ENV="development"
HOST="127.0.0.1"
PORT=8000

# LiteLLM Integration
INFERENCE_LITELLM_ENABLED=false
INFERENCE_LITELLM_FALLBACK_ENABLED=true
LITELLM_DEFAULT_TIMEOUT=60
LITELLM_DROP_PARAMS=true
LITELLM_MODEL_ALIASES_JSON="{}"
